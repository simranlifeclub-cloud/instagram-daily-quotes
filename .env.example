# ========================================================
# INSTAGRAM CREDENTIALS
# ========================================================
IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password
# Optional 100% block-bypass session ID (from browser cookie)
IG_SESSIONID=your_sessionid_cookie_value

# ========================================================
# YOUTUBE SHORTS CREDENTIALS
# ========================================================
# From Google Cloud Console (YouTube Data API v3 OAuth Desktop Client)
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret
# Generated automatically by running: python3 get_youtube_token.py
YOUTUBE_REFRESH_TOKEN=your_oauth_refresh_token
# Optional privacy setting: public (default), unlisted, private
YOUTUBE_PRIVACY_STATUS=public
