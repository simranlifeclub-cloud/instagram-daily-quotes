# Meta Graph API Credentials for Instagram Auto Posting
# Required in GitHub Repository Secrets or local .env file

# Your numeric Instagram Business or Creator Account ID (e.g., 17841400000000000)
IG_USER_ID=your_instagram_account_id_here

# Your Meta Graph API Long-Lived User or Page Access Token
META_ACCESS_TOKEN=your_meta_long_lived_access_token_here
